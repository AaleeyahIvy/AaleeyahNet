# Copy to .env (next to docker-compose.yml) and fill in with `npm run admin-setup`.
# .env is git-ignored: never commit the real values.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Only set this to true if your site has no HTTPS yet AND you understand the
# admin password would travel unencrypted. Leave it unset once HTTPS works.
# ADMIN_ALLOW_HTTP=true
